{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "courtcove/courtcove",
    "type": "project",
    "description": "CourtCove: tennis court booking and club tournaments.",
    "keywords": ["laravel", "framework"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Heinz Mayer"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.8",
        "laravel/mcp": "^0.8.2",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13.0",
        "stevebauman/location": "^7.6.3"
    },
    "require-dev": {
        "brianium/paratest": "^7.20",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/dusk": "^8.6",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "test:mysql": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php vendor/bin/phpunit -c phpunit.mysql.xml"
        ],
        "test:parallel": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test --parallel"
        ],
        "test:members": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test --testsuite=Members"
        ],
        "test:booking": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test --testsuite=Unit,Feature"
        ],
        "dusk": "@php vendor/bin/phpunit -c phpunit.dusk.xml",
        "dusk:visual": "@php vendor/bin/phpunit -c phpunit.dusk.xml --filter VisualRegressionTest",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "lint:ui": "@php artisan lint:ui",
        "check:design": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear",
            "@lint:ui",
            "@php vendor/bin/phpunit -c phpunit.design.xml"
        ],
        "lint": [
            "@lint:ui",
            "@php vendor/bin/pint --test",
            "@analyse"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@lint",
            "@composer audit",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
