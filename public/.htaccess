<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Same-host legacy app: what is left of ZF2 (its service pages and its own login) is
    # served through zf2-bridge.php. This is a strict ALLOWLIST - everything else
    # (calendar, bookings, admin, all four tournament modules, ...) stays with Laravel, so the
    # ZF2 booking UI is unreachable. Must stay above the front-controller rule below.
    # The bridge is not a public URL: THE_REQUEST is the raw client request line and is not changed by
    # the internal rewrite, so rewritten tournament requests never contain the bridge name.
    RewriteCond %{THE_REQUEST} zf2-bridge [NC]
    RewriteRule ^ - [R=404,L]

    # Ported modules (Pyramid, Mixed, Tournament, Draw incl. the public record) are served by Laravel; their
    # trailing slashes are handled by the generic slash rule further down. Rollback of one module = add its
    # prefix back to the bridge rule below (required) and to the slash redirect (otherwise "/tournament/" would
    # reach ZF2, which has no route for it). Module 4 rollback: "tournament|draw|" into both, i.e.
    #   RewriteRule ^((tournament|draw|service)(/.*)?|user/(login|logout|password(-reset)?))/$ %1 [L,R=301]
    #   RewriteRule ^(tournament|draw|service)(/|$) zf2-bridge.php [L]
    # plus, to keep the public record on Laravel, the module 1 carve-out between the two (else ZF2 serves it):
    #   RewriteRule ^draw/record(/|$) index.php [L]
    # (modules 2/3: "pyramide|" / "mixed-tournament|"). BridgedPrefixRoutesTest, PublicHtaccessTest and the
    # module's GoLive test go red by design on a rollback and must then be adjusted (NOT_YET_LIVE / allowlist).
    # A trailing slash on an allowlisted path is redirected to the slashless URL (base-path safe:
    # %1 is the full request path), because ZF2 has no route for "/service/help/".
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^((service)(/.*)?|user/(login|logout|password(-reset)?))/$ %1 [L,R=301]

    RewriteRule ^(service)(/|$) zf2-bridge.php [L]
    RewriteRule ^user/(login|logout|password(-reset)?)(/|$) zf2-bridge.php [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
