<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Same-host tournament modules: the legacy ZF2 tournament pages (and ZF2's own login)
    # are served through zf2-bridge.php. This is a strict ALLOWLIST - everything else
    # (calendar, bookings, admin, ...) stays with Laravel, so the ZF2 booking UI is
    # unreachable. Must stay above the front-controller rule below.
    # The bridge is not a public URL: THE_REQUEST is the raw client request line and is not changed by
    # the internal rewrite, so rewritten tournament requests never contain the bridge name.
    RewriteCond %{THE_REQUEST} zf2-bridge [NC]
    RewriteRule ^ - [R=404,L]

    # Ported modules (Pyramid) are served by Laravel; rollback = add the prefix back to the bridge rule
    # (the "pyramide|" in the ^(tournament|...) line below). The same prefix in the slash-redirect
    # alternation is optional: /pyramide/... slashes are also handled by the generic slash rule further down.
    # A trailing slash on an allowlisted path is redirected to the slashless URL (base-path safe:
    # %1 is the full request path), because ZF2 has no route for "/tournament/".
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^((tournament|mixed-tournament|draw|service)(/.*)?|user/(login|logout|password(-reset)?))/$ %1 [L,R=301]

    # Phase 2: ported module paths go to Laravel although their prefix is still bridged.
    # Rollback for one module = delete its line.
    RewriteRule ^draw/record(/|$) index.php [L]

    RewriteRule ^(tournament|mixed-tournament|draw|service)(/|$) zf2-bridge.php [L]
    RewriteRule ^user/(login|logout|password(-reset)?)(/|$) zf2-bridge.php [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
