# APP_NAME is the PRODUCT name (CourtCove). It also names the session cookie and the cache prefix.
APP_NAME=CourtCove
# The CLUB name comes from the administration (option service.name). BOOKING_NAME is only the fallback
# while that option is empty; without it the club name falls back to APP_NAME. Set it here or in the admin.
BOOKING_NAME="Example Tennis Club"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Staging only (database name ends in _staging): every outgoing mail goes to this one address instead of the
# recipients; with a real mailer and no valid address nothing is sent. Leave empty everywhere else.
MAIL_STAGING_REDIRECT=
MAIL_FROM_ADDRESS="hello@example.com"
# Sender name of all mails = the club name (not the product name).
MAIL_FROM_NAME="Example Tennis Club"

# Tournament mails (challenge ladder now, the other tournament modules later).
# A non-empty value on the admin "Texte" page wins over these; empty means the default.
# Reply-To for the tournament mails only (not the booking mails); empty = no Reply-To header.
# Example: MAIL_REPLY_TO_ADDRESS="sport@club.example"  MAIL_REPLY_TO_NAME="Sportwart"
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=
# Sender of the tournament mails; empty = MAIL_FROM_ADDRESS / MAIL_FROM_NAME above.
# Example: TOURNAMENT_MAIL_FROM_ADDRESS="turnier@club.example"  TOURNAMENT_MAIL_FROM_NAME="Turnierleitung"
TOURNAMENT_MAIL_FROM_ADDRESS=
TOURNAMENT_MAIL_FROM_NAME=
# Signature "Viele Grüße / club / website"; empty club = BOOKING_NAME, empty website = APP_URL.
# Example: TOURNAMENT_MAIL_SIGNATURE_CLUB="Tennisclub Beispiel"  TOURNAMENT_MAIL_SIGNATURE_URL="https://club.example"
TOURNAMENT_MAIL_SIGNATURE_CLUB=
TOURNAMENT_MAIL_SIGNATURE_URL=
# Optional full signature text replacing the default greeting; :club and :url are filled in.
# Example: TOURNAMENT_MAIL_SIGNATURE="Sportliche Grüße\n:club\n:url"
TOURNAMENT_MAIL_SIGNATURE=

# Reply-To of the booking mails (confirmation, cancellation) and of the account mails
# (password reset, account activation, login code); empty = no Reply-To header (default).
# A non-empty value on the admin "Texte" page wins over these.
# Example: MAIL_BOOKING_REPLY_TO_ADDRESS="office@club.example"  MAIL_ACCOUNT_REPLY_TO_ADDRESS="support@club.example"
MAIL_BOOKING_REPLY_TO_ADDRESS=
MAIL_ACCOUNT_REPLY_TO_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Empty = tournament pages live on the same host as this app (default). Set a full URL
# (e.g. https://turnier.example.org) only if they are served from a separate host.
TOURNAMENT_BASE_URL=

# true (default) = every tournament page needs a login. false = the Pyramid ranking, rules and challenges and the
# draw record (with its JSON) are public again; Mixed, championship and token pages always need a login.
TOURNAMENT_REQUIRE_LOGIN=true

VITE_APP_NAME="${APP_NAME}"

# WhatsApp notifications (all optional; an empty value means not set, the admin option or default applies)
WHATSAPP_DRIVER=
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_MESSAGING_SERVICE_SID=
WHATSAPP_SENDER=
WHATSAPP_SANDBOX=
WHATSAPP_SANDBOX_SENDER=
WHATSAPP_WEBHOOK_BASE_URL=
WHATSAPP_ALLOW_LIVE_ON_STAGING=
WHATSAPP_API_BASE=
WHATSAPP_API_MESSAGES_PATH=
WHATSAPP_API_ACCOUNT_PATH=
WHATSAPP_API_SERVICE_PATH=
WHATSAPP_SIGNATURE_HEADER=

# Client addresses allowed on /api (comma separated; empty = nobody)
API_ALLOWED_IPS=
